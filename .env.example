# ====================================================================
# ExamPulse - Neon PostgreSQL & Application Environment Configuration
# ====================================================================

# Neon PostgreSQL Connection URL
# Get this from your Neon Console (https://console.neon.tech):
# 1. Create a project on Neon.tech
# 2. In Dashboard, click "Connection string"
# 3. Copy the URL (pooled or standard, with sslmode=require)
DATABASE_URL=postgresql://neondb_owner:your_password_here@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional port for local development (defaults to 3000)
PORT=3000

